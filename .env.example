# Docker Compose reads this root-level file. Replace every example value before deployment.
ENV=production

# AI services
SARVAM_API_KEY=your_sarvam_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase (service-role key stays server-side)
SUPABASE_URL=https://your-project.supabase.co
DEFAULT_HOSPITAL_ID=
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend security and production controls
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
PHI_ENCRYPTION_KEY=replace_with_at_least_32_random_characters_keep_stable
AUDIO_RETENTION_HOURS=72
ALLOWED_ORIGINS=https://your-frontend.example.org
ALLOW_DEV_OTP=false

# Outbound SMS is disabled. Patient sign-in uses phone number and PIN.

# Real designated grievance contact
GRIEVANCE_OFFICER_NAME=Set the designated grievance officer name
GRIEVANCE_OFFICER_EMAIL=privacy@example.org

# Frontend values are compiled into its production bundle during image build
NEXT_PUBLIC_API_URL=https://api.yourdomain.org
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=privacy@example.org
